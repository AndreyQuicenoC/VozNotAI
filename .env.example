# Entorno de VozNotAI. Copie este archivo a .env en la raíz del repositorio.
# No coloque claves reales en el control de versiones.

APP_ENV=development
APP_SECRET_KEY=
DEBUG=false

DATABASE_URL=sqlite:///./voznotai.db
FRONTEND_ORIGIN=http://localhost:3000
COOKIE_SECURE=false
# En producción con front (Vercel) y API (Render) en dominios distintos: COOKIE_SECURE=true y COOKIE_SAMESITE=none
COOKIE_SAMESITE=lax

# Obligatorio para crear el primer administrador. No hay contraseña por defecto.
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=

LOCAL_WHISPER_MODEL=base
WHISPER_DEVICE=cpu
WHISPER_MODEL_PATH=
FFMPEG_PATH=
TRANSCRIPTION_MODE=local

TRANSCRIPTION_API_BASE_URL=https://api.openai.com/v1
# Solo en el servidor (Render). Nunca en Vercel ni en git.
TRANSCRIPTION_API_KEY=
TRANSCRIPTION_API_MODEL=whisper-1
TRANSCRIPTION_API_TIMEOUT=60

MAX_AUDIO_DURATION_SECONDS=120
MAX_UPLOAD_SIZE_BYTES=26214400
USAGE_RATE_PER_MINUTE=0.006

SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
RESET_TOKEN_TTL_MINUTES=30

# Solo el frontend. No ponga aquí claves del backend.
VITE_API_URL=
